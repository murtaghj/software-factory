{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixtures.factory.example/orders-http-v1",
  "title": "Orders API v1 (fixture)",
  "$defs": {
    "CreateOrderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sku", "quantity"],
            "properties": {
              "sku": { "type": "string", "pattern": "^SKU-[A-Z0-9-]+$" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          }
        }
      }
    },
    "Order": {
      "type": "object",
      "required": ["orderId", "customerId", "status", "items"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string" },
        "status": { "enum": ["reserved", "cancelled", "failed"] },
        "items": { "type": "array" }
      }
    }
  }
}
