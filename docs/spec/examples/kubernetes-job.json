{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "factory-run-example-g1",
    "namespace": "factory-execution-example",
    "labels": {
      "factory.example/task": "00000000-0000-4000-8000-000000000002",
      "factory.example/allocation": "example-g1",
      "factory.example/stage-run": "f58385b75cd9871425ec44b8ecc48713",
      "factory.example/generation": "1",
      "factory.example/spec-hash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    },
    "annotations": {
      "factory.example/org": "00000000-0000-4000-8000-000000000001",
      "factory.example/task": "00000000-0000-4000-8000-000000000002",
      "factory.example/stage-run-full": "task-00000000-0000-4000-8000-000000000002/plan-1/implement/attempt-1",
      "factory.example/spec-hash-full": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "factory.example/owner-epoch": "1"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 3000,
    "template": {
      "metadata": {
        "labels": {
          "factory.example/task": "00000000-0000-4000-8000-000000000002",
          "factory.example/allocation": "example-g1",
          "factory.example/stage-run": "f58385b75cd9871425ec44b8ecc48713",
          "factory.example/generation": "1",
          "factory.example/spec-hash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
        },
        "annotations": {
          "factory.example/org": "00000000-0000-4000-8000-000000000001",
          "factory.example/task": "00000000-0000-4000-8000-000000000002",
          "factory.example/stage-run-full": "task-00000000-0000-4000-8000-000000000002/plan-1/implement/attempt-1",
          "factory.example/spec-hash-full": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "factory.example/owner-epoch": "1"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "terminationGracePeriodSeconds": 15,
        "serviceAccountName": "factory-allocation-supervisor",
        "automountServiceAccountToken": false,
        "shareProcessNamespace": false,
        "securityContext": {
          "runAsNonRoot": true,
          "fsGroup": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "supervisor",
            "image": "registry.example/factory-supervisor@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "args": [
              "serve",
              "--allocation",
              "example-g1",
              "--listen",
              "127.0.0.1:8765"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsUser": 10002,
              "runAsGroup": 10002
            },
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "256Mi",
                "ephemeral-storage": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi",
                "ephemeral-storage": "1Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "workspace",
                "mountPath": "/workspace",
                "readOnly": true
              },
              {
                "name": "supervisor-tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "factory-identity",
                "mountPath": "/var/run/factory-identity",
                "readOnly": true
              }
            ]
          },
          {
            "name": "harness",
            "image": "registry.example/factory-claude-harness@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "args": [
              "qualified-runner",
              "--factory-tools",
              "http://127.0.0.1:8765/mcp",
              "--model-gateway",
              "https://model-gateway.factory.example"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsUser": 10001,
              "runAsGroup": 10001
            },
            "resources": {
              "requests": {
                "cpu": "1",
                "memory": "2Gi",
                "ephemeral-storage": "2Gi"
              },
              "limits": {
                "cpu": "4",
                "memory": "8Gi",
                "ephemeral-storage": "10Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "workspace",
                "mountPath": "/workspace"
              },
              {
                "name": "harness-tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "role-config",
                "mountPath": "/etc/factory-role",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "workspace",
            "persistentVolumeClaim": {
              "claimName": "factory-workspace-example-g1"
            }
          },
          {
            "name": "supervisor-tmp",
            "emptyDir": {
              "sizeLimit": "256Mi"
            }
          },
          {
            "name": "harness-tmp",
            "emptyDir": {
              "sizeLimit": "1Gi"
            }
          },
          {
            "name": "factory-identity",
            "projected": {
              "defaultMode": 288,
              "sources": [
                {
                  "serviceAccountToken": {
                    "path": "token",
                    "audience": "factory-control-plane",
                    "expirationSeconds": 600
                  }
                }
              ]
            }
          },
          {
            "name": "role-config",
            "configMap": {
              "name": "factory-role-example"
            }
          }
        ]
      }
    }
  }
}
