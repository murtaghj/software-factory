{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.example/spec/factory-tools/1.2.0",
  "title": "Factory tool-set contract manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "toolSetVersion": {
      "const": "1.2.0"
    }
  },
  "required": [
    "toolSetVersion"
  ],
  "x-tools": {
    "verify": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/VerifyToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/VerifyToolOutputV11"
      }
    },
    "submit_result": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/SubmitResultToolInputV12"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/SubmitResultToolOutput"
      }
    },
    "request_decision": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/RequestDecisionToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/RequestDecisionToolOutput"
      }
    },
    "get_evidence": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/GetEvidenceToolInputV12"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/GetEvidenceToolOutput"
      }
    },
    "open_hypothesis": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/OpenHypothesisToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/HypothesisToolOutput"
      }
    },
    "record_evidence": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/RecordEvidenceToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/HypothesisToolOutput"
      }
    },
    "close_hypothesis": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/CloseHypothesisToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/HypothesisToolOutput"
      }
    },
    "extend_hypothesis": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/ExtendHypothesisToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/HypothesisToolOutput"
      }
    },
    "reopen_hypothesis": {
      "inputSchema": {
        "$ref": "./domain.schema.json#/$defs/ReopenHypothesisToolInput"
      },
      "outputSchema": {
        "$ref": "./domain.schema.json#/$defs/HypothesisToolOutput"
      }
    }
  },
  "x-errorSchema": {
    "$ref": "./domain.schema.json#/$defs/FactoryToolError"
  }
}
