{
  "$comment": "Package boundary rules (W-002). Workspace packages may import only the workspace packages listed in allowWorkspace and must declare them in package.json. Apps are never importable. denyExternal lists module prefixes a package's shipped src/ code must not import (I/O-free deterministic packages); tests and build scripts are exempt. Restricted paths apply stricter allow-lists to file globs, e.g. Temporal workflow code (INV-01).",
  "packages": {
    "@factory/contracts": {
      "allowWorkspace": [],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "fastify",
        "node:fs",
        "node:net",
        "node:http",
        "node:child_process"
      ]
    },
    "@factory/domain": {
      "allowWorkspace": [
        "@factory/contracts"
      ],
      "denyExternal": [
        "node:",
        "pg",
        "@temporalio/",
        "fastify",
        "ajv"
      ]
    },
    "@factory/policy": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain"
      ],
      "denyExternal": [
        "node:",
        "pg",
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/database": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/test-support"
      ],
      "denyExternal": [
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/artifacts": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/database",
        "@factory/test-support"
      ],
      "denyExternal": [
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/workspace": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/database",
        "@factory/artifacts",
        "@factory/test-support"
      ],
      "denyExternal": [
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/test-support": {
      "allowWorkspace": [
        "@factory/contracts"
      ],
      "denyExternal": []
    },
    "@factory/runner": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/database",
        "@factory/artifacts",
        "@factory/workspace",
        "@factory/test-support",
        "@factory/runner-protocol"
      ],
      "denyExternal": [
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/api": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/policy",
        "@factory/database",
        "@factory/artifacts",
        "@factory/test-support"
      ],
      "denyExternal": [
        "@temporalio/worker",
        "@temporalio/workflow"
      ]
    },
    "@factory/dispatcher": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/database",
        "@factory/test-support"
      ],
      "denyExternal": [
        "@temporalio/worker",
        "@temporalio/workflow",
        "fastify"
      ]
    },
    "@factory/worker": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/policy",
        "@factory/database",
        "@factory/artifacts",
        "@factory/test-support"
      ],
      "denyExternal": [
        "fastify"
      ]
    },
    "@factory/dashboard": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/client"
      ],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "node:"
      ]
    },
    "@factory/fixtures": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/test-support"
      ],
      "denyExternal": [
        "@temporalio/"
      ]
    },
    "@factory/system-tests": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/policy",
        "@factory/database",
        "@factory/artifacts",
        "@factory/test-support",
        "@factory/api",
        "@factory/dispatcher",
        "@factory/worker",
        "@factory/dashboard",
        "@factory/fixtures",
        "@factory/mcp",
        "@factory/client",
        "@factory/cli"
      ],
      "denyExternal": []
    },
    "@factory/mcp": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/client"
      ],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/client": {
      "allowWorkspace": [
        "@factory/contracts"
      ],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "fastify",
        "node:"
      ]
    },
    "@factory/cli": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/client"
      ],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/runner-protocol": {
      "allowWorkspace": [],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "fastify",
        "node:fs",
        "node:net",
        "node:http",
        "node:https",
        "node:child_process"
      ]
    },
    "@factory/supervisor": {
      "allowWorkspace": [
        "@factory/runner-protocol"
      ],
      "denyExternal": [
        "pg",
        "@temporalio/",
        "fastify"
      ]
    },
    "@factory/recovery-tests": {
      "allowWorkspace": [
        "@factory/contracts",
        "@factory/domain",
        "@factory/database",
        "@factory/artifacts",
        "@factory/workspace",
        "@factory/test-support",
        "@factory/runner-protocol",
        "@factory/runner",
        "@factory/supervisor"
      ],
      "denyExternal": []
    }
  },
  "importableApps": {
    "@factory/system-tests": [
      "@factory/api",
      "@factory/dispatcher",
      "@factory/worker",
      "@factory/dashboard",
      "@factory/mcp",
      "@factory/cli"
    ],
    "@factory/recovery-tests": [
      "@factory/runner",
      "@factory/supervisor"
    ]
  },
  "restrictedPaths": [
    {
      "package": "@factory/worker",
      "glob": "src/workflows/",
      "allowPackages": [
        "@temporalio/workflow",
        "@factory/domain",
        "@factory/policy",
        "@factory/contracts"
      ],
      "allowRelativeWithin": "src/workflows",
      "reason": "INV-01: workflow code is deterministic coordination; I/O happens in Activities"
    }
  ],
  "dynamicImports": [
    {
      "package": "@factory/fixtures",
      "file": "src/runner/runner.ts",
      "reason": "fixture-test-runner loads a canonical test package's scenarios.ts from the package directory it is given"
    }
  ],
  "restrictedModules": [
    {
      "module": "@factory/runner/test-harness",
      "allowFromPackages": [
        "@factory/recovery-tests"
      ],
      "reason": "W-019: the runner's test rig is test code; nothing else imports it"
    },
    {
      "module": "@factory/runner/testing",
      "allowFromPackages": [
        "@factory/recovery-tests"
      ],
      "reason": "W-019: the fake tier and the test configuration are for tests"
    },
    {
      "module": "@factory/supervisor/testing",
      "allowFromPackages": [
        "@factory/recovery-tests"
      ],
      "allowFromPaths": [
        "@factory/supervisor/test/"
      ],
      "reason": "W-019: the supervisor's test seams (a plain loopback runner URL, uncoalesced hints) are for tests"
    },
    {
      "module": "@factory/workspace/pod",
      "allowFromPaths": [
        "@factory/runner/src/pod/",
        "@factory/runner/test/pod/",
        "@factory/workspace/test/"
      ],
      "reason": "W-019: only the pod entry may make 0750 checkouts (L6); a host caller would widen every checkout to the user's group"
    },
    {
      "module": "@factory/workspace/git-reader",
      "allowFromPaths": [
        "@factory/workspace/test/"
      ],
      "reason": "W-020a: the untrusted-Git reader has no caller until 20b; only the package's own tests import it, and 20b adds the checkpoint child's read entry"
    },
    {
      "module": "@factory/workspace/git-reader/testing",
      "allowFromPaths": [
        "@factory/workspace/test/"
      ],
      "reason": "W-020a: the reader's test seams (a spy, a swap between lstat and open, a switch that turns a check off) never reach a production caller"
    }
  ]
}
